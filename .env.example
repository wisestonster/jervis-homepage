SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Jervis News <your-account@example.com>"
# SMTP_TO=inquiries@example.com

# 홈페이지(이 웹사이트) 접속 주소. 주소가 바뀌면 이 값만 변경하고 서버를 재시작하세요.
# (SEO canonical/OG URL, next dev 허용 origin에 사용됩니다.)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# GOOGLE_SITE_VERIFICATION=your-verification-code

# 제품 데모 서버 호스트(포트만 다르고 호스트는 동일한 서버들). 홈페이지 주소와 다를 수 있어 별도로 관리합니다.
NEXT_PUBLIC_DEMO_HOST=demo.example.com

# NEWS 관리자 로그인
# ADMIN_SESSION_SECRET은 충분히 긴 임의 문자열을 사용하세요.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 기본값은 프로젝트의 data/news.db입니다.
# NEWS_DB_PATH=/var/lib/jervis-labs/news.db
